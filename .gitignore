# terraform files to ignore
# note: .terraform.lock.hcl IS committed (pins provider checksums)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
.terraform.tfstate.lock.info
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
!backend.hcl.example

# python files to ignore
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.zip

# local files to ignore
.env
.env.*
*.pem
*.key
.DS_Store
.idea/
.vscode/
.private/
