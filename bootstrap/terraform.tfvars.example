# copy to terraform.tfvars (git-ignored) and fill in
management_account_id = "123456789012"
budget_emails         = ["you+aws-budget@example.com"]
github_owner          = "your-github-user"
github_repo           = "aws-landing-zone-lab"
# IDs from: gh api repos/<owner>/<repo>/actions/oidc/customization/sub
github_owner_id       = "1234567"
github_repo_id        = "123456789"

